# --- Telegram ---
BOT_TOKEN=replace_with_bot_token
ADMIN_ID=123456789
PRIEMKA_ID=123456789
REVIEW_CHAT_ID=
PSYCHOLOG_CHAT_ID=
PSYCHOLOG_ADMIN_ID=
LOG_LEVEL=INFO
BOT_PROXY_URL=

# --- PostgreSQL на Railway (существующая БД, не пересоздаём) ---
# internal-хост работает только на сервере Railway; с Windows бот стартует без БД.
# DB_URL=postgresql://user:password@postgres.railway.internal:5432/railway
# Новые таблицы в коде — один раз на Railway: alembic upgrade head

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Не включайте на production с готовой БД (по умолчанию false):
# DB_AUTO_CREATE_TABLES=true

# --- Excel (пути от корня проекта) ---
